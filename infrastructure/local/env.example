# ==============================================================================
# TrustStay Local Development Environment Template
# ==============================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit your actual '.env' file to Git!

# --- PostgreSQL Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/truststay_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# --- Flyway Migrations ---
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# --- Security / JWT Configuration ---
# Generate a 256-bit secure secret key using OpenSSL or any secure generator
TRUSTSTAY_JWT_SECRET=replace_with_a_secure_256_bit_random_secret_string_here
TRUSTSTAY_JWT_EXPIRATION_MS=900000
TRUSTSTAY_JWT_REFRESH_EXPIRATION_MS=604800000

# --- Phone OTP Service (Mock Mode for Local Development) ---
TRUSTSTAY_OTP_MOCK_MODE=true
TRUSTSTAY_OTP_DEFAULT_TEST_CODE=123456

# --- Optional Python Fraud Detection Service ---
FRAUD_SERVICE_URL=http://localhost:8000
FRAUD_SERVICE_ENABLED=false
